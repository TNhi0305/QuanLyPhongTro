    users ||--o{ notifications : "nhận thông báo"

    rental_areas ||--o{ rooms : "chứa"
    rooms ||--o{ contracts : "cho thuê"
    tenants ||--o{ contracts : "ký hợp đồng"

    contracts ||--o{ invoices : "phát sinh kỳ thu"
    invoices ||--o{ invoice_details : "chi tiết dòng"
    invoices ||--o{ payments : "được thanh toán"
